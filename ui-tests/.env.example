# Copy to ui-tests/.env (git-ignored) or set these in your shell. Only the E2E layer needs them;
# the UI layer (npm run test:ui) needs nothing.

# An Admin account on the running stack (no users are seeded — create one first).
E2E_ADMIN_EMAIL=admin@medicore.local
E2E_ADMIN_PASSWORD=

# The API gateway of the docker stack.
E2E_GATEWAY_URL=http://localhost:5000

# ── Or: the live Azure deployment ──────────────────────────────────────────
# Uncomment both lines to run the journeys against production instead of docker.
# The journey creates a test patient (surname E2E…) and books then cancels one slot.
# E2E_APP_URL=https://proud-water-0f2255f00.5.azurestaticapps.net
# E2E_GATEWAY_URL=https://medicore-gateway.azurewebsites.net
# Against the live site, setup will NOT create doctor schedules unless you allow it:
# E2E_ALLOW_PROVISIONING=1

# Optional: how long to wait for Kafka-driven state (ms).
# E2E_EVENTUAL_TIMEOUT_MS=45000

# Optional: use an already-installed Chromium instead of `npx playwright install`.
# PW_CHROMIUM_PATH=
