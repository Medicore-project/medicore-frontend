{
  "name": "medicore-ui-tests",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SE3112 UI / E2E testing for MediCore: Playwright UI tests with API test doubles, plus full-stack journeys across the four microservices.",
  "scripts": {
    "test": "playwright test --project=ui-chromium",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:headed": "playwright test --project=ui-chromium --headed",
    "test:ui:cross-browser": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:e2e": "playwright test --project=e2e-stack --workers=1",
    "test:e2e:headed": "playwright test --project=e2e-stack --workers=1 --headed",
    "test:all": "playwright test --project=ui-chromium --project=e2e-stack --workers=1",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "playwright-core": "1.56.1",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
